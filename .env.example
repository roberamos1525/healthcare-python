# Local development settings for docker compose. Copy to .env and change every password.
# Never commit .env. Production secrets belong in a secret manager, not in files.

# PostgreSQL superuser (used only by the container's first-start initialization).
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser

# Schema owner that runs migrations, and the restricted role the API uses at runtime.
HEALTHCARE_MIGRATOR_PASSWORD=change-me-migrator
HEALTHCARE_APP_PASSWORD=change-me-app

# RabbitMQ credentials for the local broker.
RABBITMQ_USER=healthcare
RABBITMQ_PASSWORD=change-me-rabbitmq

# Optional in Development (temporary keys are generated at startup when empty).
# Required in every other environment.
#   AUTH_FIELD_ENCRYPTION_KEY: base64 of 32 random bytes, e.g. `openssl rand -base64 32`
#   AUTH_SIGNING_KEY_PEM: RSA private key in PEM form, e.g. `openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072`
AUTH_FIELD_ENCRYPTION_KEY=
AUTH_SIGNING_KEY_PEM=

# Base URL of the web application, used in links inside emails.
FRONTEND_BASE_URL=http://localhost:5173
